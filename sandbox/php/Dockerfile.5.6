# PHP 5.6.40 CLI. Tag is frozen upstream (EOL).
# evalhook needs zend_string (PHP 7+), so dump mode cannot hook eval() here.
# Observe still runs with request profiles, WordPress stubs, and the sleep hook.
FROM php:5.6-cli

COPY debian-archive.sh /tmp/debian-archive.sh
RUN /bin/sh /tmp/debian-archive.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        $PHPIZE_DEPS \
        ca-certificates \
        dnsmasq \
        gcc \
        libc6-dev \
        libcurl4-openssl-dev \
        python \
        tcpdump \
        iproute2 \
        iptables \
        zlib1g-dev \
    && docker-php-ext-install curl \
    && rm -rf /var/lib/apt/lists/*

# Stretch images may only ship Python 2; the sink is written for Python 3.
# Prefer python3 when the archive still has it.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-crypto || true

COPY php-sandbox.ini /usr/local/etc/php/conf.d/zz-sandbox.ini
COPY entrypoint.sh prepend.php wp-stubs.php sink.py collect_domains.py tcp_logger.py dnsmasq.conf sleep_hook.c /opt/sandbox/
RUN gcc -shared -fPIC -O2 -o /opt/sandbox/nosleep.so /opt/sandbox/sleep_hook.c \
    && chmod +x /opt/sandbox/entrypoint.sh /opt/sandbox/tcp_logger.py \
    && mkdir -p /logs /samples /tmp/ca

ENTRYPOINT ["/opt/sandbox/entrypoint.sh"]
